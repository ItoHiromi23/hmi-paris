{
  "kind": "collectionType",
  "collectionName": "main_events",
  "info": {
    "singularName": "main-event",
    "pluralName": "main-events",
    "displayName": "Main Event",
    "description": "Seasonal / special events (add or remove freely)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "label": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "badgeText": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "category": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "summary": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "inclusions": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroImageUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "eventDate": {
      "type": "date",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "venue": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "priceFrom": {
      "type": "decimal",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "currency": {
      "type": "string",
      "default": "EUR",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "ctaLabel": {
      "type": "string",
      "default": "View details",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "featured": {
      "type": "boolean",
      "default": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "notes": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "bookingUnlimited": {
      "type": "boolean",
      "default": false,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "slotsTotal": {
      "type": "integer",
      "default": 20,
      "min": 0,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "slotsSold": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
