{
  "kind": "collectionType",
  "collectionName": "tour_sessions",
  "info": {
    "singularName": "tour-session",
    "pluralName": "tour-sessions",
    "displayName": "Tour Session",
    "description": "Bookable date/time slots for a tour package"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "tourPackage": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tour-package.tour-package",
      "inversedBy": "sessions"
    },
    "packageSlug": {
      "type": "string",
      "required": true
    },
    "startsAt": {
      "type": "datetime",
      "required": true
    },
    "endsAt": {
      "type": "datetime",
      "required": true
    },
    "capacity": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1
    },
    "sold": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "sessionStatus": {
      "type": "enumeration",
      "enum": ["open", "closed", "cancelled"],
      "default": "open",
      "required": true
    },
    "label": {
      "type": "string"
    }
  }
}
