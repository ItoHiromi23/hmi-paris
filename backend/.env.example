HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Default CMS locale (English is source of truth; Japanese is a linked translation)
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=en

# Auto-translate the twin locale when you save EN or JA in the admin (default: on)
# AUTO_TRANSLATE=false
# Optional DeepL key for higher-quality EN↔JA (free keys end with :fx). Without it, MyMemory is used.
# DEEPL_AUTH_KEY=your-deepl-key:fx

# Set to true once to wipe editorial CMS and reseed EN + JA (then remove)
# CMS_RESEED=true

# Public URL of this Strapi service (Railway domain)
# PUBLIC_URL=https://rare-adventure-production-c645.up.railway.app

# Frontend origin allowed by CORS (no trailing slash)
# CORS_ORIGINS=https://meridia-production-157a.up.railway.app

# Local default: sqlite. On Railway use postgres + DATABASE_URL.
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# Railway / production (prefer internal URL; use PUBLIC_URL if private networking fails)
# DATABASE_CLIENT=postgres
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_SSL=false
# If AggregateError persists, try the public proxy instead:
# DATABASE_URL=${{Postgres.DATABASE_PUBLIC_URL}}
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# PUBLIC_URL=https://rare-adventure-production-c645.up.railway.app
