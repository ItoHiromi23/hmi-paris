HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Default CMS locale (English is source of truth; Japanese is a linked translation)
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=en

# Auto-translate the twin locale when you save EN or JA in the admin (default: on)
# AUTO_TRANSLATE=false
# Optional DeepL key for higher-quality EN↔JA (free keys end with :fx). Without it, MyMemory is used.
# DEEPL_AUTH_KEY=your-deepl-key:fx

# Set to true once to wipe editorial CMS and reseed EN + JA (then remove — do NOT leave on)
# CMS_RESEED=true
#
# After deploy, bootstrap auto-backfills empty About / Arc detail fields onto existing
# rows (keeps production slugs). No wipe required for new columns.
# Public URL of this Strapi service (Railway domain)
# PUBLIC_URL=https://rare-adventure-production-c645.up.railway.app

# Frontend origin allowed by CORS (no trailing slash)
# CORS_ORIGINS=https://meridia-production-157a.up.railway.app

# -----------------------------------------------------------------------------
# Database — production MUST use Postgres (sqlite is wiped on every redeploy)
# -----------------------------------------------------------------------------
# Local default: sqlite. On Railway, leave DATABASE_CLIENT unset when DATABASE_URL
# is set — Postgres is selected automatically.
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# Railway / production
# DATABASE_CLIENT=postgres
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_SSL=false
# If AggregateError persists, try the public proxy instead:
# DATABASE_URL=${{Postgres.DATABASE_PUBLIC_URL}}
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# -----------------------------------------------------------------------------
# Persistent media (pick ONE — otherwise uploads vanish on Railway redeploy)
# -----------------------------------------------------------------------------
#
# Option A — Railway Volume (simplest)
#   Strapi service → Settings → Volumes → add volume
#   Mount path: /app/public/uploads
#   (Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically)
#
# Option B — Cloudflare R2 (S3-compatible, recommended for multi-instance)
# R2_ACCESS_KEY_ID=
# R2_ACCESS_SECRET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# (or a custom domain pointing at the bucket)
#
# Option C — AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_SECRET=
# AWS_REGION=eu-west-1
# AWS_BUCKET=
# CDN_URL=https://your-bucket.s3.eu-west-1.amazonaws.com
# AWS_ACL=public-read
# For path-style endpoints (MinIO / IONOS): AWS_S3_FORCE_PATH_STYLE=true
# For R2-like providers without ACL: AWS_S3_OMIT_ACL=true
