# Local
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Resend — https://resend.com/api-keys)
# Nuxt also reads the NUXT_ prefixed names at runtime on Vercel.
RESEND_API_KEY=re_xxxxxxxx
NUXT_RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=HMI Paris <onboarding@resend.dev>
NUXT_EMAIL_FROM=HMI Paris <onboarding@resend.dev>
CONTACT_TO=info@hmiparis.com
NUXT_CONTACT_TO=info@hmiparis.com

# --- Vercel (Production + Preview + Development) ---
# Root Directory: frontend
# Framework: Nuxt
# Output Directory: leave EMPTY
#
# NUXT_PUBLIC_SITE_URL=https://www.hmiparis.com
# RESEND_API_KEY=re_xxxxxxxx
# NUXT_RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=HMI Paris <info@hmiparis.com>
# NUXT_EMAIL_FROM=HMI Paris <info@hmiparis.com>
# CONTACT_TO=info@hmiparis.com
# NUXT_CONTACT_TO=info@hmiparis.com
#
# onboarding@resend.dev can only send to the Resend account email.
# Verify hmiparis.com at https://resend.com/domains before using info@hmiparis.com as EMAIL_FROM.
