NUXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Stripe CLI: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Must match backend ORDERS_SHARED_SECRET (saves payments into Strapi Orders)
ORDERS_SHARED_SECRET=change-me-to-a-long-random-string

# Booking confirmation email (Resend — https://resend.com/api-keys)
# Without this, payment still works; only the custom confirmation email is skipped.
# Also enable Stripe Dashboard → Settings → Customer emails → Successful payments
# for Stripe's own payment receipt.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=HMI Paris <bookings@yourdomain.com>

# --- Railway production example ---
# HOST=0.0.0.0
# NITRO_HOST=0.0.0.0
# NODE_ENV=production
# NUXT_PUBLIC_SITE_URL=https://meridia-production-157a.up.railway.app
