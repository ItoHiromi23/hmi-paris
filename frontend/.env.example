NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email (Resend — https://resend.com/api-keys)
# Without RESEND_API_KEY the form still validates locally; mail is skipped in development.
RESEND_API_KEY=re_xxxxxxxx
# onboarding@resend.dev can only send to the Resend account email.
# After verifying hmiparis.com in Resend, use a from-address on that domain:
EMAIL_FROM=HMI Paris <onboarding@resend.dev>
CONTACT_TO=info@hmiparis.com

# --- Vercel production ---
# Root Directory: frontend
# Framework: Nuxt
# Output Directory: leave EMPTY (do not set .output/public — that drops /api/contact)
# NUXT_PUBLIC_SITE_URL=https://www.hmiparis.com
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=HMI Paris <info@hmiparis.com>
# CONTACT_TO=info@hmiparis.com

# --- Railway production example ---
# HOST=0.0.0.0
# NITRO_HOST=0.0.0.0
# NODE_ENV=production
# NUXT_PUBLIC_SITE_URL=https://hmiparis.fr
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=HMI Paris <info@hmiparis.com>
# CONTACT_TO=info@hmiparis.com
